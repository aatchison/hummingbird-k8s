# Fixable CRITICAL vulnerability counts per image, measured by the
# `containerfile-build` job in pr-validate.yml.
#
# This is a RATCHET. A PR fails if its count EXCEEDS the number here; it
# never fails for being under. Both counts below are inherited from the
# bootc-os base image, not introduced by this repo — see the CVE list in
# the workflow comment. Lower these whenever the base image is bumped, so
# the improvement is locked in and cannot silently regress.
#
# Measured 2026-08-22 against the images built from the pinned base digest.
# 2026-08-22: base bumped 3bed2fc1 -> 2e29eb2b, 12 -> 11 on both images.
# The base's own CRITICAL is gone; the remaining 11 are in packages this
# repo layers on (Go stdlib x6 + grpc x4 in the k8s/cri-o binaries,
# capnp x1) and need a K8S_VERSION / cri-o bump, not a base bump.
k8s=11
k8s-worker=11
